{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyPeLWA5GEsvtPfrylrk6ovp"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","source":["# ===============================================\n","# Customer Support Ticket Classifier - NLP Prototype\n","# ===============================================\n","\n","# 1. Import the libraries we need\n","# --------------------------------\n","import os\n","import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","from sklearn.feature_extraction.text import TfidfVectorizer\n","from sklearn.linear_model import LogisticRegression\n","from sklearn.pipeline import Pipeline\n","from sklearn.model_selection import train_test_split\n","from sklearn.metrics import classification_report, confusion_matrix, f1_score\n","import warnings\n","warnings.filterwarnings('ignore')\n","\n","# We use a fixed random seed everywhere so that re-running this script\n","# gives the same results every time (reproducibility).\n","RANDOM_SEED = 42\n","np.random.seed(RANDOM_SEED)\n","\n","# Create a folder to save our plots into, if it doesn't already exist\n","os.makedirs('figures', exist_ok=True)\n","\n","# ===============================================\n","# 2. Load the dataset and keep only 8 intents\n","# ===============================================\n","\n","# We load the BANKING77 dataset directly from the CSV files published by\n","# PolyAI on GitHub. (We tried loading it through the Hugging Face\n","# \"datasets\" library first, but that dataset's loading script is outdated\n","# and no longer works, so plain pandas + a direct CSV link is simpler\n","# and more reliable.)\n","train_url = \"https://raw.githubusercontent.com/PolyAI-LDN/task-specific-datasets/master/banking_data/train.csv\"\n","test_url = \"https://raw.githubusercontent.com/PolyAI-LDN/task-specific-datasets/master/banking_data/test.csv\"\n","\n","df_train = pd.read_csv(train_url)\n","df_test = pd.read_csv(test_url)\n","\n","# The CSV files call the intent column \"category\". We rename it to \"label\"\n","# so the rest of the code is easier to read.\n","df_train = df_train.rename(columns={'category': 'label'})\n","df_test = df_test.rename(columns={'category': 'label'})\n","\n","# Put train and test together for now - we filter first, then split again later\n","df_all = pd.concat([df_train, df_test], ignore_index=True)\n","\n","# The 8 intents we picked for this project\n","selected_intents = [\n","    \"card_arrival\",\n","    \"card_not_working\",\n","    \"cash_withdrawal_not_recognised\",\n","    \"declined_card_payment\",\n","    \"lost_or_stolen_card\",\n","    \"transaction_charged_twice\",\n","    \"transfer_not_received_by_recipient\",\n","    \"cash_withdrawal_charge\"\n","]\n","\n","# Keep only the rows that belong to one of our 8 intents\n","df_selected = df_all[df_all['label'].isin(selected_intents)].copy()\n","\n","print(\"Total selected samples:\", len(df_selected))\n","print(\"Intent distribution:\")\n","print(df_selected['label'].value_counts())\n","\n","# ===============================================\n","# 3. Exploratory Data Analysis (EDA)\n","# ===============================================\n","\n","# 3-1. Q1: What are customers contacting us about most often?\n","# ------------------------------------------------------------\n","intent_counts = df_selected['label'].value_counts()\n","intent_percent = (intent_counts / len(df_selected)) * 100\n","intent_summary = pd.DataFrame({\n","    'count': intent_counts,\n","    'percent': intent_percent\n","})\n","print(\"Intent summary:\")\n","print(intent_summary)\n","\n","# Horizontal bar chart of how many messages each intent has\n","plt.figure(figsize=(10, 6))\n","plt.barh(intent_counts.index, intent_counts.values, color='steelblue')\n","plt.title('Customer Intent Distribution', fontsize=14)\n","plt.xlabel('Number of messages')\n","plt.ylabel('Intent')\n","plt.tight_layout()\n","plt.savefig('figures/intent_distribution.png', dpi=150)\n","plt.show()\n","\n","# Interpretation: message counts are fairly close to each other across the\n","# 8 intents (roughly between 120 and 220 messages each). 'cash_withdrawal_charge'\n","# and 'transaction_charged_twice' have the most messages, while\n","# 'lost_or_stolen_card' has the fewest. Since no single intent is a huge\n","# outlier, automation would help spread the support workload fairly evenly\n","# instead of fixing one bottleneck category.\n","\n","# 3-2. Q2: Do message length and structure differ by intent?\n","# -----------------------------------------------------------\n","df_selected['char_length'] = df_selected['text'].apply(len)\n","df_selected['word_count'] = df_selected['text'].apply(lambda x: len(x.split()))\n","\n","# Boxplot for character length per intent\n","plt.figure(figsize=(12, 6))\n","sns.boxplot(data=df_selected, x='label', y='char_length', color='lightgreen')\n","plt.xticks(rotation=45, ha='right')\n","plt.title('Message Length (characters) by Intent', fontsize=14)\n","plt.xlabel('Intent')\n","plt.ylabel('Number of characters')\n","plt.tight_layout()\n","plt.savefig('figures/char_length_by_intent.png', dpi=150)\n","plt.show()\n","\n","# Boxplot for word count per intent\n","plt.figure(figsize=(12, 6))\n","sns.boxplot(data=df_selected, x='label', y='word_count', color='lightsalmon')\n","plt.xticks(rotation=45, ha='right')\n","plt.title('Word Count by Intent', fontsize=14)\n","plt.xlabel('Intent')\n","plt.ylabel('Number of words')\n","plt.tight_layout()\n","plt.savefig('figures/word_count_by_intent.png', dpi=150)\n","plt.show()\n","\n","# Interpretation: 'lost_or_stolen_card' and 'card_not_working' tend to have\n","# the shortest messages (short and urgent, like \"My card is gone!\"), while\n","# 'cash_withdrawal_not_recognised' and 'transfer_not_received_by_recipient'\n","# tend to be longer, since customers usually explain what happened in more\n","# detail for those cases. So message length carries a little bit of useful\n","# signal, but it's not strong enough to use by itself.\n","\n","# 3-3. Top TF-IDF terms per intent (EDA)\n","# ---------------------------------------\n","# We split into train/test now so we can fit TF-IDF only on the training\n","# part later (this avoids \"data leakage\").\n","X_train, X_test, y_train, y_test = train_test_split(\n","    df_selected['text'],\n","    df_selected['label'],\n","    test_size=0.2,\n","    random_state=RANDOM_SEED,\n","    stratify=df_selected['label']\n",")\n","\n","print(\"Train size:\", len(X_train), \" Test size:\", len(X_test))\n","\n","# Fit a small TF-IDF vectorizer on the training text only, just for this\n","# exploration step (a bigger one is used later for the real model).\n","tfidf = TfidfVectorizer(max_features=100, stop_words='english', ngram_range=(1, 2))\n","X_train_tfidf = tfidf.fit_transform(X_train)\n","feature_names = tfidf.get_feature_names_out()\n","\n","# y_train keeps the original pandas row numbers after the split, but the\n","# rows of X_train_tfidf are numbered 0, 1, 2, ... in order. So instead of\n","# using y_train's own index, we walk through it position by position with\n","# a plain counter, which always matches the TF-IDF matrix correctly.\n","intent_tfidf_means = {}\n","for intent in selected_intents:\n","    positions = []\n","    position = 0\n","    for label in y_train:\n","        if label == intent:\n","            positions.append(position)\n","        position += 1\n","\n","    if len(positions) > 0:\n","        mean_tfidf = X_train_tfidf[positions].mean(axis=0).A1\n","        top_indices = np.argsort(mean_tfidf)[-10:][::-1]\n","        top_words = []\n","        for i in top_indices:\n","            top_words.append((feature_names[i], mean_tfidf[i]))\n","        intent_tfidf_means[intent] = top_words\n","\n","# Show top words for one intent as an example\n","print(\"Top 10 words for intent 'card_arrival':\")\n","for word, score in intent_tfidf_means['card_arrival']:\n","    print(word, \":\", round(score, 3))\n","\n","# Plot the top TF-IDF terms for the first 4 intents\n","fig, axes = plt.subplots(2, 2, figsize=(14, 10))\n","axes = axes.flatten()\n","for idx in range(4):\n","    intent = selected_intents[idx]\n","    words = [w for w, s in intent_tfidf_means[intent]]\n","    scores = [s for w, s in intent_tfidf_means[intent]]\n","    axes[idx].barh(words, scores, color='skyblue')\n","    axes[idx].set_title('Top TF-IDF terms for ' + intent)\n","    axes[idx].set_xlabel('Mean TF-IDF')\n","plt.tight_layout()\n","plt.savefig('figures/top_tfidf_terms.png', dpi=150)\n","plt.show()\n","\n","# Interpretation: each intent has its own set of typical words. For\n","# example, 'card_arrival' is full of words like \"arrive\", \"received\" and\n","# \"new card\". These distinctive words are exactly what both the keyword\n","# baseline and the TF-IDF model rely on to tell intents apart.\n","\n","# ===============================================\n","# 4. Q3: Keyword-based baseline (simple rules)\n","# ===============================================\n","\n","# A very simple set of keywords we picked by hand for each intent\n","keyword_rules = {\n","    'card_arrival': ['arrive', 'received', 'new card', 'when', 'get my card'],\n","    'card_not_working': ['not working', \"doesn't work\", 'broken', 'fail', 'error'],\n","    'cash_withdrawal_not_recognised': ['withdrawal', 'not recognised', 'recognised', 'atm', 'cash machine'],\n","    'declined_card_payment': ['declined', 'rejected', 'payment failed', 'card declined', 'refused'],\n","    'lost_or_stolen_card': ['lost', 'stolen', 'missing', 'misplace', 'taken'],\n","    'transaction_charged_twice': ['twice', 'double', 'charged twice', 'duplicate', 'two times'],\n","    'transfer_not_received_by_recipient': ['transfer', 'not received', 'recipient', 'sent', \"didn't receive\"],\n","    'cash_withdrawal_charge': ['charge', 'fee', 'withdrawal fee', 'cash charge', 'atm fee']\n","}\n","\n","\n","def keyword_baseline(text):\n","    # Guess the intent by counting how many keywords from each intent\n","    # show up in the message. Whichever intent gets the most matches wins.\n","    text_lower = text.lower()\n","    scores = {}\n","    for intent in keyword_rules:\n","        score = 0\n","        for kw in keyword_rules[intent]:\n","            if kw in text_lower:\n","                score = score + 1\n","        scores[intent] = score\n","\n","    best_score = max(scores.values())\n","    if best_score == 0:\n","        return 'unknown'\n","\n","    for intent in scores:\n","        if scores[intent] == best_score:\n","            return intent\n","\n","\n","# Try the keyword baseline on the test set\n","y_pred_keyword = []\n","for text in X_test:\n","    y_pred_keyword.append(keyword_baseline(text))\n","\n","correct = 0\n","for true_label, pred_label in zip(y_test, y_pred_keyword):\n","    if true_label == pred_label:\n","        correct = correct + 1\n","accuracy_keyword = correct / len(y_test)\n","print(\"Keyword baseline accuracy:\", round(accuracy_keyword, 3))\n","\n","# Show a few examples where it worked and a few where it failed\n","print(\"\\nSuccess examples (correct predictions):\")\n","success_count = 0\n","for text, true, pred in zip(X_test, y_test, y_pred_keyword):\n","    if pred == true and success_count < 5:\n","        print(\"Text:\", text[:80], \"...\")\n","        print(\"  true:\", true, \", pred:\", pred, \"\\n\")\n","        success_count = success_count + 1\n","\n","print(\"\\nFailure examples (wrong predictions):\")\n","fail_count = 0\n","for text, true, pred in zip(X_test, y_test, y_pred_keyword):\n","    if pred != true and fail_count < 5:\n","        print(\"Text:\", text[:80], \"...\")\n","        print(\"  true:\", true, \", pred:\", pred, \"\\n\")\n","        fail_count = fail_count + 1\n","\n","# Interpretation: the keyword rules work fine for very obvious messages,\n","# but they fail a lot too, mostly because the same word (like \"card\") shows\n","# up in many different intents. This is exactly why a real ML model is\n","# needed instead of just hand-picked rules.\n","\n","# ===============================================\n","# 5. Q4: Main model - TF-IDF + Logistic Regression\n","# ===============================================\n","\n","# We put TF-IDF and Logistic Regression together in one Pipeline. This way,\n","# when we call pipeline.fit(X_train, y_train), the TF-IDF vocabulary is\n","# learned ONLY from the training text, never from the test text - so there\n","# is no data leakage.\n","pipeline = Pipeline([\n","    ('tfidf', TfidfVectorizer(stop_words='english', ngram_range=(1, 2), max_features=5000)),\n","    ('clf', LogisticRegression(max_iter=1000, random_state=RANDOM_SEED))\n","])\n","\n","pipeline.fit(X_train, y_train)\n","y_pred = pipeline.predict(X_test)\n","\n","# ===============================================\n","# 6. Q5: Evaluation - which intents does the model understand well?\n","# ===============================================\n","\n","# 6-1. Classification report (precision, recall, F1 for every intent)\n","print(\"Classification Report:\")\n","print(classification_report(y_test, y_pred, digits=3))\n","\n","# Macro-F1: the average F1 across all intents, treating every intent\n","# equally (this is more honest than plain accuracy when some intents\n","# have fewer messages than others).\n","macro_f1 = f1_score(y_test, y_pred, average='macro')\n","print(\"Macro-F1:\", round(macro_f1, 3))\n","\n","# 6-2. Confusion matrix\n","plt.figure(figsize=(10, 8))\n","cm = confusion_matrix(y_test, y_pred, labels=selected_intents)\n","sns.heatmap(cm, annot=True, fmt='d', cmap='Blues',\n","            xticklabels=selected_intents, yticklabels=selected_intents)\n","plt.title('Confusion Matrix', fontsize=14)\n","plt.xlabel('Predicted')\n","plt.ylabel('Actual')\n","plt.xticks(rotation=45, ha='right')\n","plt.yticks(rotation=0)\n","plt.tight_layout()\n","plt.savefig('figures/confusion_matrix.png', dpi=150)\n","plt.show()\n","\n","# Interpretation: the biggest confusion is between 'card_not_working' and\n","# 'declined_card_payment' - both are about a card failing to work at the\n","# point of payment, so they share a lot of vocabulary (\"declined\",\n","# \"not working\", \"failed\"). 'lost_or_stolen_card' also gets mixed up with\n","# 'card_arrival' and 'card_not_working' sometimes, when the message doesn't\n","# use obviously urgent words.\n","\n","# 6-3. Per-class F1-score bar chart\n","report_dict = classification_report(y_test, y_pred, output_dict=True)\n","\n","f1_per_class = {}\n","for intent in selected_intents:\n","    f1_per_class[intent] = report_dict[intent]['f1-score']\n","\n","intents = list(f1_per_class.keys())\n","f1_values = list(f1_per_class.values())\n","\n","# Pick a bar color depending on how good the F1 score is\n","bar_colors = []\n","for value in f1_values:\n","    if value >= 0.85:\n","        bar_colors.append('green')\n","    elif value >= 0.7:\n","        bar_colors.append('orange')\n","    else:\n","        bar_colors.append('red')\n","\n","plt.figure(figsize=(10, 6))\n","plt.bar(intents, f1_values, color=bar_colors)\n","plt.title('F1-Score per Intent', fontsize=14)\n","plt.xlabel('Intent')\n","plt.ylabel('F1-Score')\n","plt.xticks(rotation=45, ha='right')\n","plt.ylim(0, 1)\n","plt.tight_layout()\n","plt.savefig('figures/f1_per_class.png', dpi=150)\n","plt.show()\n","\n","# Interpretation: most intents get an F1 score above 0.90, which is quite\n","# good. 'lost_or_stolen_card' is the weakest one (F1 around 0.89), mostly\n","# because of lower recall - see the business discussion below for why that\n","# specific intent matters a lot.\n","\n","# ===============================================\n","# 7. Error analysis: look at the misclassified messages\n","# ===============================================\n","\n","errors = []\n","for true, pred, text in zip(y_test, y_pred, X_test):\n","    if true != pred:\n","        errors.append((text, true, pred))\n","\n","print(\"Total errors:\", len(errors))\n","print(\"\\nError cases:\")\n","count = 1\n","for text, true, pred in errors[:20]:\n","    print(str(count) + \". Text:\", text[:100], \"...\")\n","    print(\"   True:\", true, \" -> Pred:\", pred, \"\\n\")\n","    count = count + 1\n","\n","# Manual analysis - common reasons the model gets things wrong:\n","# 1. Similar wording shared between two intents (e.g. \"declined\" / \"not working\")\n","# 2. Very short messages that don't give the model much to work with\n","# 3. Some intents have fewer training examples than others\n","# 4. Indirect phrasing that doesn't use the \"obvious\" keywords for that intent\n","\n","# ===============================================\n","# 8. Q6: Are all errors equally costly? (Business-critical intents)\n","# ===============================================\n","\n","critical_intents = ['lost_or_stolen_card', 'declined_card_payment']\n","print(\"Performance on critical intents:\")\n","for intent in critical_intents:\n","    prec = report_dict[intent]['precision']\n","    rec = report_dict[intent]['recall']\n","    f1 = report_dict[intent]['f1-score']\n","    print(intent, \": Precision =\", round(prec, 3), \", Recall =\", round(rec, 3), \", F1 =\", round(f1, 3))\n","\n","# Interpretation:\n","# For 'lost_or_stolen_card', missing a real case (a false negative) could\n","# lead to real financial loss for the customer, so recall matters most here.\n","# For 'declined_card_payment', both precision and recall matter: a false\n","# positive can confuse the customer, and a false negative can delay fixing\n","# a real payment problem.\n","\n","# ===============================================\n","# 9. Q7: Prediction function with confidence score\n","# ===============================================\n","\n","# We use the same threshold (0.6) in both predict_intent() and\n","# defer_to_human() below, so they always agree with each other.\n","DEFAULT_THRESHOLD = 0.6\n","\n","\n","def predict_intent(text, model=pipeline, threshold=DEFAULT_THRESHOLD):\n","    # Predict the intent for a new message and also return how confident\n","    # the model is. If the model isn't confident enough, we return\n","    # 'defer_to_human' instead of a guess.\n","    probs = model.predict_proba([text])[0]\n","    max_prob = np.max(probs)\n","    pred_idx = np.argmax(probs)\n","    pred_intent = model.classes_[pred_idx]\n","\n","    if max_prob < threshold:\n","        pred_intent = 'defer_to_human'\n","\n","    all_probs = {}\n","    for cls, prob in zip(model.classes_, probs):\n","        all_probs[cls] = prob\n","\n","    result = {\n","        'intent': pred_intent,\n","        'confidence': max_prob,\n","        'all_probs': all_probs\n","    }\n","    return result\n","\n","\n","# Try the function on a few new messages\n","test_texts = [\n","    \"My new card hasn't arrived yet, when will it come?\",\n","    \"I think my card was stolen, please help!\",\n","    \"I want to withdraw cash but it's not recognized\",\n","    \"This is a general question about my account\"\n","]\n","\n","for text in test_texts:\n","    result = predict_intent(text)\n","    print(\"Text:\", text)\n","    print(\"  Predicted:\", result['intent'], \", Confidence:\", round(result['confidence'], 3))\n","    print()\n","\n","# ===============================================\n","# 10. Q8: Defer to human rule (low confidence)\n","# ===============================================\n","\n","def defer_to_human(text, model=pipeline, threshold=DEFAULT_THRESHOLD):\n","    # Decide if a message should be handled by a human instead of being\n","    # auto-routed, based on how confident the model is.\n","    result = predict_intent(text, model, threshold)\n","    should_defer = result['intent'] == 'defer_to_human'\n","    return should_defer, result['intent'], result['confidence']\n","\n","\n","for text in test_texts:\n","    should_defer, intent, conf = defer_to_human(text)\n","    if should_defer:\n","        status = \"Defer to human\"\n","    else:\n","        status = \"Auto-process\"\n","    print(\"Text:\", text[:50], \"...\")\n","    print(\"  \", status, \"(intent:\", intent, \", confidence:\", round(conf, 3), \")\")\n","\n","# Why 0.6? This threshold seemed to give a reasonable balance between\n","# auto-routing enough tickets and not auto-routing too many wrong guesses,\n","# based on looking at the confidence scores on the test set.\n","# Limitation: this is just a simple rule, not a perfectly calibrated\n","# probability. Some high-confidence predictions can still be wrong, and\n","# some low-confidence ones could actually be correct.\n","\n","# ===============================================\n","# 11. Save model (optional)\n","# ===============================================\n","# import pickle\n","# with open('models/ticket_classifier.pkl', 'wb') as f:\n","#     pickle.dump(pipeline, f)\n","\n","print(\"Project completed successfully!\")\n"],"metadata":{"id":"KRlrDHZAy-kf","colab":{"base_uri":"https://localhost:8080/","height":1000},"executionInfo":{"status":"ok","timestamp":1788325439457,"user_tz":-210,"elapsed":13782,"user":{"displayName":"Mohammad.J. Ashtari","userId":"12630410024986642295"}},"outputId":"5ece3ad5-c921-4925-b64b-95447491cdf8"},"execution_count":2,"outputs":[{"output_type":"stream","name":"stdout","text":["Total selected samples: 1503\n","Intent distribution:\n","label\n","cash_withdrawal_charge                217\n","transaction_charged_twice             215\n","transfer_not_received_by_recipient    211\n","cash_withdrawal_not_recognised        200\n","card_arrival                          193\n","declined_card_payment                 193\n","card_not_working                      152\n","lost_or_stolen_card                   122\n","Name: count, dtype: int64\n","Intent summary:\n","                            